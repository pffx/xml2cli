<config xmlns="http://tail-f.com/ns/config/1.0">
  <syslog xmlns="urn:ietf:params:xml:ns:yang:ietf-syslog">
    <actions>
      <file>
        <log-file>
          <name>syslog.log</name>
          <facility-filter>
            <facility-list>
              <facility>user</facility>
              <severity>info</severity>
            </facility-list>
          </facility-filter>
        </log-file>
      </file>
    </actions>
  </syslog>
</config>

